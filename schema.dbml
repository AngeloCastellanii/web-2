// ==========================================
// PAYROLL SYSTEM - DATA MODEL (ENGLISH)
// ==========================================

// ------------------------------------------
// 1. IDENTITY & ACCESS CONTROL (RBAC)
// ------------------------------------------

Table person {
  person_id int [pk, increment]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  national_id varchar(20) [unique, not null]
  birth_date date
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table user {
  user_id int [pk, increment]
  person_id int [ref: - person.person_id, not null, unique]
  email varchar(150) [unique, not null]
  password_hash varchar(255) [not null]
  is_active boolean [default: true, not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table profile {
  profile_id int [pk, increment]
  name varchar(50) [unique, not null] // Admin, HR, Employee
  description varchar(255)
}

Table user_profile {
  user_profile_id int [pk, increment]
  user_id int [ref: > user.user_id, not null]
  profile_id int [ref: > profile.profile_id, not null]

  indexes {
    (user_id, profile_id) [unique]
  }
}

// Security objects for course-style reflection /proccess
Table object {
  object_id int [pk, increment]
  object_de varchar(100) [unique, not null] // BO class name: Employee, Payroll, ...
}

Table method {
  method_id int [pk, increment]
  object_id int [ref: > object.object_id, not null]
  method_de varchar(100) [not null] // Method name on BO class
  method_atx boolean [default: true] // Active flag

  indexes {
    (object_id, method_de) [unique]
  }
}

Table permission {
  permission_id int [pk, increment]
  profile_id int [ref: > profile.profile_id, not null]
  method_id int [ref: > method.method_id, not null]

  indexes {
    (profile_id, method_id) [unique]
  }
}

// ------------------------------------------
// 2. ORGANIZATION & EMPLOYEES
// ------------------------------------------

Table department {
  department_id int [pk, increment]
  name varchar(100) [unique, not null]
  description varchar(255)
  is_active boolean [default: true, not null]
  created_at timestamp [default: `now()`]
}

Table position {
  position_id int [pk, increment]
  name varchar(100) [unique, not null]
  description varchar(255)
  is_active boolean [default: true, not null]
  created_at timestamp [default: `now()`]
}

Table pay_frequency {
  pay_frequency_id int [pk, increment]
  name varchar(50) [unique, not null] // WEEKLY, BIWEEKLY, MONTHLY
  description varchar(255)
}

Table employee {
  employee_id int [pk, increment]
  person_id int [ref: - person.person_id, not null, unique]
  hire_date date [not null]
  pay_modality varchar(20) [not null] // HOURLY | FIXED
  base_salary decimal(12,2) [not null] // Hourly rate or fixed salary
  pay_frequency_id int [ref: > pay_frequency.pay_frequency_id, not null]
  department_id int [ref: > department.department_id, not null]
  position_id int [ref: > position.position_id, not null]
  is_active boolean [default: true, not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

// ------------------------------------------
// 3. PAYROLL & CONCEPTS
// ------------------------------------------

Table payroll {
  payroll_id int [pk, increment]
  start_date date [not null]
  end_date date [not null]
  pay_date date
  status varchar(20) [default: 'DRAFT', not null] // DRAFT (n times) | FINALIZED (once)
  pay_frequency_id int [ref: > pay_frequency.pay_frequency_id, not null]
  notes varchar(255)
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table payroll_entry {
  payroll_entry_id int [pk, increment]
  payroll_id int [ref: > payroll.payroll_id, not null]
  employee_id int [ref: > employee.employee_id, not null]
  total_earnings decimal(12,2) [default: 0.00, not null] // CREDIT sum
  total_deductions decimal(12,2) [default: 0.00, not null] // DEBIT sum
  net_total decimal(12,2) [default: 0.00, not null]
  created_at timestamp [default: `now()`]

  indexes {
    (payroll_id, employee_id) [unique]
  }
}

Table concept {
  concept_id int [pk, increment]
  name varchar(100) [unique, not null]
  effect varchar(10) [not null] // CREDIT | DEBIT
  category varchar(50) [not null] // LEGAL_DEDUCTION | OPTIONAL | BONUS | OVERTIME | LOAN | BASE_SALARY
  is_automatic boolean [default: false, not null]
  calc_type varchar(30) // PERCENT_SALARY | FIXED_AMOUNT | MANUAL
  calc_value decimal(12,4) // e.g. 0.0400 for 4%
  is_active boolean [default: true, not null]
  created_at timestamp [default: `now()`]
}

Table payroll_detail {
  payroll_detail_id int [pk, increment]
  payroll_entry_id int [ref: > payroll_entry.payroll_entry_id, not null]
  concept_id int [ref: > concept.concept_id, not null]
  quantity decimal(12,2) [default: 1.00, not null] // Overtime hours, days worked, etc.
  amount decimal(12,2) [not null]
  created_at timestamp [default: `now()`]
}

Table payment {
  payment_id int [pk, increment]
  payroll_entry_id int [ref: > payroll_entry.payroll_entry_id, not null]
  payment_date date [not null]
  amount decimal(12,2) [not null]
  payment_method varchar(50) // TRANSFER | CASH | CHECK
  notes varchar(255)
  created_at timestamp [default: `now()`]
}

// ------------------------------------------
// 4. LOANS
// ------------------------------------------

Table loan {
  loan_id int [pk, increment]
  employee_id int [ref: > employee.employee_id, not null]
  total_amount decimal(12,2) [not null]
  remaining_balance decimal(12,2) [not null]
  installment decimal(12,2) [not null]
  start_date date [not null]
  status varchar(20) [default: 'ACTIVE', not null] // ACTIVE | PAID
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}
